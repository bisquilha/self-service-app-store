<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- Envio de versões do app da loja (~70 MB) pelo painel. O padrão do IIS é ~30 MB. -->
          <requestLimits maxAllowedContentLength="262144000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
