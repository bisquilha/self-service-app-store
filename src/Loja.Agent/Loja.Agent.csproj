<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Loja.Agent</RootNamespace>
    <AssemblyName>LojaAgent</AssemblyName>
    <Version>0.2.0</Version>
    <!-- Serviço do Windows: só roda em Windows (registro, WTS). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loja.Shared\Loja.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- agent.json é da máquina (endereço do servidor e certificado): fica ao lado do .exe, nunca dentro do pacote. -->
    <None Update="agent.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
