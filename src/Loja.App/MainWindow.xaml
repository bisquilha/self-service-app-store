<Window x:Class="Loja.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Loja.App"
        Title="Loja de Aplicativos"
        Icon="/Assets/loja.ico"
        Width="1100" Height="740" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <DockPanel>

        <!-- Cabeçalho: título e o que a loja faz à esquerda; usuário, computador e (para a TI) o painel à direita. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" Padding="24,11">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="UserText" Foreground="{DynamicResource HeaderText}" FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="HostText" Foreground="{DynamicResource HeaderSubtext}" FontSize="12"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Loja de Aplicativos" Foreground="{DynamicResource HeaderText}" FontSize="21" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Instale os programas liberados para você, sem precisar de senha de administrador."
                               Foreground="{DynamicResource HeaderSubtext}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Versão nova do app pronta (autoupdate) -->
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Background="{DynamicResource InfoBarBg}" BorderBrush="{DynamicResource InfoBarBorder}"
                BorderThickness="0,0,0,1" Padding="24,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Reiniciar agora" Style="{StaticResource FlatButton}" Padding="12,4"
                        Click="RestartNow_Click" />
                <TextBlock x:Name="UpdateText" Foreground="{DynamicResource InfoBarText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- Aviso sobre a máquina / conexão -->
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}"
                BorderThickness="0,0,0,1" Padding="24,9" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Barra de status -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgSurfaceAlt}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0" Padding="24,6">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Grid Margin="24,10,24,10">
        <TabControl x:Name="Tabs">

            <!-- ===== Loja ===== -->
            <TabItem Header="Aplicativos">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Busca e "Atualizar lista" na mesma linha -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" MinHeight="34" TextChanged="SearchBox_TextChanged"
                                     AutomationProperties.Name="Buscar aplicativo"
                                     ToolTip="Digite parte do nome ou da descrição (Ctrl+F). Esc limpa a busca." />
                            <TextBlock Text="Buscar aplicativo…" Foreground="{DynamicResource TextMuted}" Margin="11,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="ReloadButton" Grid.Column="1" Content="Atualizar lista" Style="{StaticResource SecondaryButton}"
                                MinHeight="34" Margin="10,0,0,0" Click="Reload_Click"
                                ToolTip="Atualiza a lista e confere de novo os programas instalados neste computador (F5)" />
                    </Grid>

                    <!-- Atualizações pendentes deste computador -->
                    <Border x:Name="UpdatesBar" Grid.Row="1" Margin="0,0,0,12" Padding="14,7" CornerRadius="6" Visibility="Collapsed"
                            Background="{DynamicResource InfoBarBg}" BorderBrush="{DynamicResource InfoBarBorder}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="StopButton" Content="Parar" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Visibility="Collapsed" Click="StopBatch_Click"
                                        ToolTip="Termina o aplicativo que está sendo atualizado e não começa os próximos" />
                                <Button x:Name="UpdateAllButton" Content="Atualizar todos" Style="{StaticResource FlatButton}" MinWidth="120"
                                        Click="UpdateAll_Click"
                                        ToolTip="Atualiza, um de cada vez, os aplicativos deste computador que têm versão nova" />
                            </StackPanel>
                            <TextBlock x:Name="UpdatesText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite">
                                <Run x:Name="UpdatesTitle" FontWeight="SemiBold" /><Run x:Name="UpdatesDetail" FontSize="12" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="CatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <ItemsControl x:Name="CatalogList" Margin="0,0,6,6" AutomationProperties.Name="Aplicativos disponíveis">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:CardPanel MinCardWidth="320" CardHeight="212" Gap="14" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,12" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Topo: ícone, nome e versão disponível -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="40" Height="40" Margin="0,0,12,0">
                                                        <Border CornerRadius="9" Background="{Binding AvatarBrush}"
                                                                Visibility="{Binding ShowAvatar, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}" />
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Descrição (em inglês, como vem do repositório): no máximo 3 linhas; o texto inteiro aparece na dica -->
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,8,0,6" VerticalAlignment="Top"
                                                           FontSize="12.5" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="48"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding Description}" />

                                                <!-- Rodapé fixo: situação, versões e botões. Sempre as mesmas três faixas. -->
                                                <StackPanel Grid.Row="2">
                                                    <DockPanel Height="20">
                                                        <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,0" VerticalAlignment="Center" CornerRadius="9"
                                                                Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1"
                                                                Visibility="{Binding ShowOutsideBadge, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="Fora da loja" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource WarnText}" />
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" Width="16" TextAlignment="Center"
                                                                   VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource StatusKindText}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" Style="{StaticResource StatusKindText}"
                                                                   ToolTip="{Binding StatusTip}" />
                                                    </DockPanel>
                                                    <TextBlock Height="18" Margin="16,0,0,0" Text="{Binding DetailText}" FontSize="12"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextSecondary}" ToolTip="{Binding DetailText}" />
                                                    <ProgressBar Margin="0,3,0,0" Height="3">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                <!-- valores padrão no Style (e não no elemento) para o gatilho abaixo poder mudá-los -->
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                <Setter Property="IsIndeterminate" Value="False" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="IsIndeterminate" Value="True" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" MinHeight="30">
                                                        <Button Content="Desinstalar" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0"
                                                                Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVisibility}}"
                                                                IsEnabled="{Binding UninstallEnabled}" Click="Uninstall_Click" Tag="{Binding}"
                                                                AutomationProperties.Name="{Binding UninstallAutomationName}"
                                                                ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True" />
                                                        <Button Content="{Binding PrimaryText}" Style="{StaticResource FlatButton}" MinWidth="96"
                                                                Visibility="{Binding ShowPrimary, Converter={StaticResource BoolToVisibility}}"
                                                                IsEnabled="{Binding PrimaryEnabled}" Click="Primary_Click" Tag="{Binding}"
                                                                AutomationProperties.Name="{Binding PrimaryAutomationName}"
                                                                ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Carregando / lista vazia / erro / busca sem resultado -->
                        <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                                    Margin="0,0,0,30" Visibility="Collapsed">
                            <ProgressBar x:Name="StateProgress" IsIndeterminate="True" Width="220" Margin="0,0,0,16" Visibility="Collapsed" />
                            <TextBlock x:Name="StateTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="StateMessage" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Button x:Name="StateButton" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    MinWidth="120" Visibility="Collapsed" Click="StateButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== Meus pedidos ===== -->
            <TabItem Header="Meus pedidos">
                <Grid>
                    <DataGrid x:Name="MyRequestsGrid" IsReadOnly="True" AutomationProperties.Name="Meus pedidos">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="140" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Aplicativo" Binding="{Binding Title}" Width="200" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Computador" Binding="{Binding Hostname}" Width="140" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Situação" Binding="{Binding StatusText}" Width="120" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="MyRequestsEmpty" Text="Você ainda não fez nenhum pedido por aqui." Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Só para quem é da TI: o painel de administração abre no navegador. Fica na linha das abas, à direita. -->
        <Button x:Name="AdminButton" Content="Abrir painel de administração" Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" Visibility="Collapsed" Click="OpenAdmin_Click"
                ToolTip="Abre o painel de administração da loja no navegador"
                AutomationProperties.Name="Abrir painel de administração" />
        </Grid>
    </DockPanel>
</Window>
